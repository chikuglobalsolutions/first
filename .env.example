# ── Database ───────────────────────────────────────────────
# Dev: SQLite (file). Prod: swap to Postgres (Neon/Supabase free tier)
DATABASE_URL="file:./dev.db"

# ── Auth (NextAuth) ─────────────────────────────────────────
# Production: set to your actual Netlify/Vercel URL
NEXTAUTH_URL="https://chikuglobalsolutions.com"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# ── Stripe ──────────────────────────────────────────────────
# Get from: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# PromptEmpire price IDs (already using direct Stripe links, these are backup)
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_BUSINESS_PRICE_ID="price_..."

# ── Email (Magic Link auth) ──────────────────────────────────
# Recommended: Resend.com (free tier, 100 emails/day)
# signup at resend.com → API Keys → create key → use below
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_your_api_key_here"
EMAIL_FROM="noreply@chikuglobalsolutions.com"

# ── AI Systems intake form notifications ────────────────────
# Same Resend account as auth; needed to email new intake submissions.
# Without RESEND_API_KEY, submissions still persist to the DB and log to
# Netlify function logs (best-effort, non-fatal), they just don't email.
RESEND_API_KEY="re_your_api_key_here"
# Must be a verified sender in Resend; falls back to Resend's demo address.
INTAKE_FROM_EMAIL="onboarding@chikuglobalsolutions.com"
# Where new intake submissions are emailed; falls back to chikuglobalsolutions@gmail.com.
INTAKE_NOTIFY_EMAIL="chikuglobalsolutions@gmail.com"

# ── Admin endpoints ─────────────────────────────────────────
# Shared secret for /api/admin/seed-stripe. Without it, the endpoint
# refuses all requests (the route returns 401). Generate: openssl rand -hex 32
ADMIN_SEED_TOKEN="replace-me"
